{
    "name": "systems-analysis-tool",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "start": "node scripts/serve.mjs",
        "start:intranet": "node scripts/serve.mjs --host 0.0.0.0",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test tests/*.test.mjs",
        "screenshots": "node scripts/screenshots.mjs",
        "predev": "node scripts/prepare-globe.mjs",
        "prebuild": "node scripts/prepare-globe.mjs"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "5.3.0",
        "cesium": "1.145.0",
        "occt-import-js": "^0.0.23",
        "papaparse": "5.7.0",
        "three": "0.185.1",
        "uplot": "1.6.32"
    },
    "devDependencies": {
        "@types/node": "22.19.19",
        "@types/papaparse": "5.5.2",
        "@types/three": "0.185.4",
        "typescript": "5.9.3",
        "vite": "8.2.2"
    }
}
