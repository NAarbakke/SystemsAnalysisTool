{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/**/*.ts",
    "models/**/*.ts",
    "models/**/*.js",
    "vite.config.ts"
  ]
}
